{
  "name": "pizzaria-whatsapp-delivery-desktop",
  "type": "module",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "test": "vitest run",
    "dev": "electron . --no-sandbox --disable-gpu",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.pizzaria.whatsapp-delivery-desktop",
    "productName": "Pizzaria WhatsApp Delivery",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mupdf": "^1.3.0",
    "openai": "^4.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "whatsapp-web.js": "^1.26.0"
  }
}
